# empresas/locale/es/LC_MESSAGES/django.po
# Traducciones al ESPAÑOL del módulo empresas (elegir empresa).
#
# Cómo se usa:
#   msgid  = el texto en inglés, EXACTAMENTE como está en el código o la plantilla.
#   msgstr = su traducción. Si se deja vacío (""), se muestra en inglés.
#   %(nombre)s y {nombre} son datos que se ponen después (no se traducen, solo se mueven).
# Después de editar este archivo:
#   python manage.py compilar_idiomas      (crea el django.mo que lee Django)
#   y reiniciar el sistema.

